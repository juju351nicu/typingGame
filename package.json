{
  "name": "typinggame",
  "version": "0.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "create-post": "node scripts/create-post.mjs",
    "generate:posts": "node scripts/generate-posts.mjs",
    "check:posts": "npm run generate:posts && git diff --exit-code blog_store/posts-index.json",
    "dev:api": "cross-env VITE_ENABLE_BACKEND_API=true VITE_API_BASE_URL=http://localhost:8091 vite --host localhost --port 8081 --strictPort"
  },
  "dependencies": {
    "dayjs": "^1.11.19",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.2.0",
    "simple-keyboard": "^3.8.93",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "vuetify": "^3.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/font": "^7.4.47",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.1.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.11"
  }
}
